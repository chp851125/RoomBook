@page
@model RoomBook.Pages.Admin.Approvals.IndexModel
@inject ITimeProvider Time
@{
    ViewData["Title"] = "審核待辦";
    ViewData["Nav"] = "admin";
}

<h1 class="h4 mb-3"><i class="bi bi-gear me-2"></i>管理後台</h1>
<partial name="_AdminNav" model='"approvals"' />

@if (Model.Rows.Count == 0)
{
    <div class="text-center text-muted py-5"><i class="bi bi-check2-all display-5"></i><p class="mt-2">沒有待審核的預約。</p></div>
}
else
{
    <div class="row g-3">
        @for (var i = 0; i < Model.Rows.Count; i++)
        {
            var r = Model.Rows[i];
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2">
                            <h2 class="h6 mb-1">
                                @if (r.BookingId is not null) { <a class="text-decoration-none" asp-page="/Bookings/Details" asp-route-id="@r.BookingId">@r.Title</a> }
                                else { <a class="text-decoration-none" asp-page="/Bookings/Details" asp-route-seriesId="@r.SeriesId" asp-route-date="@Time.ToLocal(r.StartUtc).ToString("yyyy-MM-dd")">@r.Title</a> }
                                @if (r.SeriesId is not null) { <i class="bi bi-arrow-repeat text-muted ms-1" title="週期預約"></i> }
                            </h2>
                            <span class="badge text-bg-warning align-self-start">待審核</span>
                        </div>
                        <div class="small text-muted mb-2">
                            <i class="bi bi-door-open me-1"></i>@r.RoomName ·
                            <i class="bi bi-clock me-1"></i>@Time.Format(r.StartUtc, "MM/dd HH:mm")–@Time.Format(r.EndUtc, "HH:mm") ·
                            <i class="bi bi-people me-1"></i>@r.AttendeeCount 人
                        </div>
                        @if (r.RecurrenceText is not null) { <div class="small mb-1"><i class="bi bi-arrow-repeat me-1"></i>@r.RecurrenceText（整組審核）</div> }
                        <div class="small mb-1">申請人：<strong>@r.Organizer</strong>（@r.Department），@Time.Format(r.CreatedAt, "MM/dd HH:mm") 送出</div>
                        @if (!string.IsNullOrWhiteSpace(r.Description)) { <div class="small text-muted mb-2">@r.Description</div> }
                        <div class="d-flex gap-2 mt-3">
                            <form method="post" asp-page-handler="Approve" class="flex-fill">
                                <input type="hidden" name="id" value="@r.BookingId" /><input type="hidden" name="seriesId" value="@r.SeriesId" />
                                <button class="btn btn-success w-100"><i class="bi bi-check-lg me-1"></i>核准</button>
                            </form>
                            <button class="btn btn-outline-danger flex-fill" type="button" data-bs-toggle="collapse" data-bs-target="#reject-@i"><i class="bi bi-x-lg me-1"></i>駁回</button>
                        </div>
                        <form method="post" asp-page-handler="Reject" class="collapse mt-2" id="reject-@i">
                            <input type="hidden" name="id" value="@r.BookingId" /><input type="hidden" name="seriesId" value="@r.SeriesId" />
                            <div class="input-group">
                                <input name="reason" class="form-control" placeholder="駁回原因（必填，會通知申請人）" maxlength="200" required />
                                <button class="btn btn-danger">確認駁回</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
