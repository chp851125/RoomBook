@page
@model RoomBook.Pages.Admin.Rooms.IndexModel
@{
    ViewData["Title"] = "會議室維護";
    ViewData["Nav"] = "admin";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0 me-auto"><i class="bi bi-gear me-2"></i>管理後台</h1>
    <a class="btn btn-primary btn-sm" asp-page="/Admin/Rooms/Edit"><i class="bi bi-plus-lg me-1"></i>新增會議室</a>
</div>
<partial name="_AdminNav" model='"rooms"' />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>排序</th><th>名稱</th><th>樓層</th><th>容納</th><th>設備</th><th>審核</th><th>狀態</th><th>未來預約</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rooms)
            {
                <tr>
                    <td>@r.SortOrder</td>
                    <td class="fw-semibold">@r.Name</td>
                    <td>@r.Floor 樓</td>
                    <td>@r.Capacity 人</td>
                    <td class="small">@string.Join("、", r.Equipment)</td>
                    <td>@(r.RequiresApproval ? "需審核" : "—")</td>
                    <td><partial name="_RoomStatusBadge" model="r.Status" /></td>
                    <td>@Model.FutureCounts[r.Id]</td>
                    <td class="text-nowrap text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Display/Index" asp-route-roomId="@r.Id" target="_blank" title="看板頁"><i class="bi bi-tv"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Rooms/Edit" asp-route-id="@r.Id">編輯</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
