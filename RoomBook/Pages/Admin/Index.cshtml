@page
@model RoomBook.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "管理後台";
    ViewData["Nav"] = "admin";
}

<h1 class="h4 mb-3"><i class="bi bi-gear me-2"></i>管理後台</h1>
<partial name="_AdminNav" model='"home"' />

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><a class="stat-card d-block text-decoration-none text-body" asp-page="/Admin/Approvals/Index"><div class="stat-num @(Model.PendingCount > 0 ? "text-warning" : "")">@Model.PendingCount</div><div class="text-muted small">待審核預約</div></a></div>
    <div class="col-6 col-md-3"><a class="stat-card d-block text-decoration-none text-body" asp-page="/Admin/Users/Index"><div class="stat-num">@Model.ActiveUserCount<small class="text-muted">/@Model.UserCount</small></div><div class="text-muted small">啟用使用者</div></a></div>
    <div class="col-6 col-md-3"><a class="stat-card d-block text-decoration-none text-body" asp-page="/Admin/Users/Index" asp-route-suspended="true"><div class="stat-num @(Model.SuspendedCount > 0 ? "text-danger" : "")">@Model.SuspendedCount</div><div class="text-muted small">暫停預約中</div></a></div>
    <div class="col-6 col-md-3"><a class="stat-card d-block text-decoration-none text-body" asp-page="/Admin/Rooms/Index"><div class="stat-num">@Model.RoomCount</div><div class="text-muted small">會議室</div></a></div>
</div>

<div class="row g-2 mb-4">
    <div class="col-6 col-md-3"><a class="quick-tile" asp-page="/Bookings/Create"><i class="bi bi-person-plus"></i>代為預約</a></div>
    <div class="col-6 col-md-3"><a class="quick-tile" asp-page="/Admin/Bookings/Index"><i class="bi bi-x-octagon"></i>強制取消</a></div>
    <div class="col-6 col-md-3"><a class="quick-tile" asp-page="/Admin/Stats/Index"><i class="bi bi-bar-chart-line"></i>使用統計</a></div>
    <div class="col-6 col-md-3"><a class="quick-tile" href="/health" target="_blank"><i class="bi bi-heart-pulse"></i>健康檢查</a></div>
</div>

@if (Model.AllowReset)
{
    <div class="card border-danger-subtle shadow-sm">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="flex-grow-1">
                <h2 class="h6 mb-1"><i class="bi bi-arrow-counterclockwise me-1"></i>重置為範例資料</h2>
                <div class="text-muted small">清空 App_Data 並從 SeedData 重新複製，完成後回到登入頁。僅管理員可用，會寫入稽核紀錄。</div>
            </div>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#resetDataModal">重置為範例資料</button>
        </div>
    </div>
}
