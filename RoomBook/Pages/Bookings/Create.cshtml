@page
@model RoomBook.Pages.Bookings.CreateModel
@using RoomBook.Application.Dtos
@{
    ViewData["Title"] = Model.IsEdit ? "修改預約" : "新增預約";
    ViewData["Nav"] = "";
    var input = Model.Input;
    string[] dayNames = ["日", "一", "二", "三", "四", "五", "六"];
    var weekdayOrder = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
}

<nav aria-label="breadcrumb"><ol class="breadcrumb small mb-2">
    <li class="breadcrumb-item"><a asp-page="/Bookings/Index">行事曆</a></li>
    <li class="breadcrumb-item active">@(Model.IsEdit ? "修改預約" : "新增預約")</li>
</ol></nav>
<h1 class="h4 mb-3">@(Model.IsEdit ? "修改預約" : "新增預約")</h1>

<form method="post" id="bookingForm" data-check-url="@Url.Page("/Bookings/Create", "Check")" data-max-hours="@Model.MaxDurationHours">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-lg-7">
            @if (Model.IsAdminUser && !Model.IsEdit)
            {
                <div class="card border-0 shadow-sm mb-3 border-start border-4 border-primary">
                    <div class="card-body">
                        <label asp-for="Input.OrganizerId" class="form-label fw-semibold"><i class="bi bi-person-plus me-1"></i>代為預約（預約人）</label>
                        <select asp-for="Input.OrganizerId" class="form-select">
                            @foreach (var c in Model.Candidates) { <option value="@c.Id" selected="@(c.Id == Model.Input.OrganizerId)">@c.DisplayName@(c.Id == Model.CurrentUserIdValue ? "（我自己）" : "")</option> }
                        </select>
                        <div class="form-text">選擇其他人時，預約直接確認，不受審核、過去時段與暫停限制，並通知預約人。</div>
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold">時間與地點</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Input.RoomId" class="form-label">會議室</label>
                            <select asp-for="Input.RoomId" class="form-select">
                                <option value="">請選擇…</option>
                                @foreach (var r in Model.Rooms)
                                {
                                    <option value="@r.Id" data-capacity="@r.Capacity" selected="@(input.RoomId == r.Id)">@r.Name（@r.Floor 樓，@r.Capacity 人@(r.RequiresApproval ? "，需審核" : "")）</option>
                                }
                            </select>
                            <span asp-validation-for="Input.RoomId" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-5">
                            <label asp-for="Input.Date" class="form-label">日期</label>
                            <input asp-for="Input.Date" type="date" class="form-control" />
                            <span asp-validation-for="Input.Date" class="text-danger small"></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <label asp-for="Input.StartTime" class="form-label">開始</label>
                            <input asp-for="Input.StartTime" type="time" step="900" class="form-control" />
                            <span asp-validation-for="Input.StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <label asp-for="Input.EndTime" class="form-label">結束</label>
                            <input asp-for="Input.EndTime" type="time" step="900" class="form-control" />
                            <span asp-validation-for="Input.EndTime" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <span class="small text-muted me-1">快速時長</span>
                            @foreach (var m in new[] { 30, 60, 90, 120 })
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm me-1 duration-btn" data-minutes="@m">@(m < 60 ? $"{m} 分" : m % 60 == 0 ? $"{m / 60} 小時" : $"{m / 60.0:0.#} 小時")</button>
                            }
                        </div>
                    </div>

                    @if (Model.IsEdit)
                    {
                        <input type="hidden" name="Input.Recurrence" value="None" />
                        <input type="hidden" name="Input.EditId" value="@Model.Input.EditId" />
                    }
                    else
                    {
                    <hr />
                    <div class="row g-3">
                        <div class="col-12 col-md-5">
                            <label asp-for="Input.Recurrence" class="form-label">重複</label>
                            <select asp-for="Input.Recurrence" class="form-select">
                                <option value="None">不重複</option>
                                <option value="Weekly">每週</option>
                                <option value="BiWeekly">每兩週</option>
                                <option value="Monthly">每月（同日期）</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-5 recur-only">
                            <label asp-for="Input.RecurrenceEndDate" class="form-label">重複到</label>
                            <input asp-for="Input.RecurrenceEndDate" type="date" class="form-control" />
                        </div>
                        <div class="col-12 recur-weekdays">
                            <span class="small me-2">星期</span>
                            @foreach (var d in weekdayOrder)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="Input.DaysOfWeek" id="dow-@((int)d)" value="@((int)d)" checked="@input.DaysOfWeek.Contains(d)" />
                                    <label class="form-check-label" for="dow-@((int)d)">@dayNames[(int)d]</label>
                                </div>
                            }
                            <div class="form-text">不勾選則以開始日的星期為準。最多展開 52 次，遇假日會自動略過。</div>
                        </div>
                    </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold">會議內容</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label">主題</label>
                        <input asp-for="Input.Title" class="form-control" maxlength="100" placeholder="例如：Q4 業務檢討會" />
                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-4">
                            <label asp-for="Input.AttendeeCount" class="form-label">參會人數</label>
                            <input asp-for="Input.AttendeeCount" type="number" min="1" class="form-control" />
                            <span asp-validation-for="Input.AttendeeCount" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <span class="small me-2">所需設備</span>
                            @foreach (var e in Model.EquipmentOptions)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="Input.RequiredEquipment" id="eq-@e" value="@e" checked="@input.RequiredEquipment.Contains(e)" />
                                    <label class="form-check-label" for="eq-@e">@e</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div>
                        <label asp-for="Input.Description" class="form-label">說明</label>
                        <textarea asp-for="Input.Description" rows="3" class="form-control" maxlength="1000"></textarea>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between">參與者<span class="text-muted small fw-normal" id="pickedCount"></span></div>
                <div class="card-body">
                    <input type="search" id="peopleFilter" class="form-control form-control-sm mb-2" placeholder="搜尋同事姓名或部門…" />
                    <div class="people-list border rounded p-2 mb-3">
                        @foreach (var u in Model.People)
                        {
                            var dept = Model.Departments.GetValueOrDefault(u.DepartmentId, "");
                            <div class="form-check people-item" data-search="@(u.DisplayName + dept)">
                                <input class="form-check-input people-check" type="checkbox" name="Input.ParticipantIds" id="p-@u.Id" value="@u.Id" checked="@input.ParticipantIds.Contains(u.Id)" />
                                <label class="form-check-label w-100" for="p-@u.Id">@u.DisplayName <span class="text-muted small">@dept · @u.JobTitle</span></label>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold small">外部訪客</span>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="addGuest"><i class="bi bi-plus"></i> 新增訪客</button>
                    </div>
                    <div id="guestRows" data-next="@input.Guests.Count">
                        @for (var i = 0; i < input.Guests.Count; i++)
                        {
                            <div class="row g-2 mb-2 guest-row">
                                <div class="col-12 col-md-4"><input name="Input.Guests[@i].Name" value="@input.Guests[i].Name" class="form-control form-control-sm" placeholder="姓名" /></div>
                                <div class="col-12 col-md-4"><input name="Input.Guests[@i].Company" value="@input.Guests[i].Company" class="form-control form-control-sm" placeholder="公司" /></div>
                                <div class="col-10 col-md-3"><input name="Input.Guests[@i].Email" value="@input.Guests[i].Email" type="email" class="form-control form-control-sm" placeholder="Email（選填）" /></div>
                                <div class="col-2 col-md-1"><button type="button" class="btn btn-sm btn-outline-danger remove-guest" aria-label="移除"><i class="bi bi-trash"></i></button></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="sticky-lg-top check-panel">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold">即時檢查</div>
                    <div class="card-body">
                        <div id="checkResult" aria-live="polite">
                            @if (Model.Result is { } result)
                            {
                                <partial name="_BookingCheck" model="(result, false)" />
                            }
                            else
                            {
                                <div class="text-muted small">選好會議室與時間後，會自動檢查衝突、營業時段與預約規則。</div>
                            }
                        </div>
                    </div>
                </div>
                @if (Model.Input.ConflictPolicy != ConflictPolicy.Ask)
                {
                    <input type="hidden" name="Input.ConflictPolicy" value="@Model.Input.ConflictPolicy" />
                }
                <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-check2-circle me-1"></i>@(Model.IsEdit ? "儲存修改" : "送出預約")</button>
                <a class="btn btn-link w-100 mt-1" asp-page="/Bookings/Index">取消</a>
            </div>
        </div>
    </div>
</form>

<template id="guestTemplate">
    <div class="row g-2 mb-2 guest-row">
        <div class="col-12 col-md-4"><input name="Input.Guests[__i__].Name" class="form-control form-control-sm" placeholder="姓名" /></div>
        <div class="col-12 col-md-4"><input name="Input.Guests[__i__].Company" class="form-control form-control-sm" placeholder="公司" /></div>
        <div class="col-10 col-md-3"><input name="Input.Guests[__i__].Email" type="email" class="form-control form-control-sm" placeholder="Email（選填）" /></div>
        <div class="col-2 col-md-1"><button type="button" class="btn btn-sm btn-outline-danger remove-guest" aria-label="移除"><i class="bi bi-trash"></i></button></div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking-form.js" asp-append-version="true"></script>
}
