@page
@model RoomBook.Pages.Rooms.IndexModel
@{
    ViewData["Title"] = "會議室";
    ViewData["Nav"] = "rooms";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0 me-auto">會議室</h1>
    <a class="btn btn-success btn-sm" asp-page="/Rooms/Available"><i class="bi bi-lightning-charge me-1"></i>現在有空</a>
    <div class="btn-group btn-group-sm" role="group" aria-label="檢視方式">
        <a class="btn @(Model.View != "list" ? "btn-primary" : "btn-outline-primary")" asp-route-view="card"
           asp-route-floor="@Model.Floor" asp-route-minCapacity="@Model.MinCapacity" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")"
           asp-route-from="@Model.From?.ToString("HH:mm")" asp-route-to="@Model.To?.ToString("HH:mm")"><i class="bi bi-grid"></i> 卡片</a>
        <a class="btn @(Model.View == "list" ? "btn-primary" : "btn-outline-primary")" asp-route-view="list"
           asp-route-floor="@Model.Floor" asp-route-minCapacity="@Model.MinCapacity" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")"
           asp-route-from="@Model.From?.ToString("HH:mm")" asp-route-to="@Model.To?.ToString("HH:mm")"><i class="bi bi-list-ul"></i> 清單</a>
    </div>
</div>

<form method="get" class="card border-0 shadow-sm mb-3">
    <input type="hidden" name="view" value="@Model.View" />
    <div class="card-body">
        <div class="row g-2">
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="floor">樓層</label>
                <select id="floor" name="floor" class="form-select form-select-sm">
                    <option value="">全部</option>
                    @foreach (var f in Model.Floors) { <option value="@f" selected="@(Model.Floor == f)">@f 樓</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="minCapacity">至少人數</label>
                <input id="minCapacity" name="minCapacity" type="number" min="1" class="form-control form-control-sm" value="@Model.MinCapacity" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small mb-1" for="date">可用時段</label>
                <input id="date" name="date" type="date" class="form-control form-control-sm" value="@Model.Date?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="from">開始</label>
                <input id="from" name="from" type="time" step="900" class="form-control form-control-sm" value="@Model.From?.ToString("HH:mm")" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="to">結束</label>
                <input id="to" name="to" type="time" step="900" class="form-control form-control-sm" value="@Model.To?.ToString("HH:mm")" />
            </div>
            <div class="col-12">
                <span class="small me-2">設備</span>
                @foreach (var e in Model.EquipmentOptions)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="equipment" id="eq-@e" value="@e" checked="@Model.Equipment.Contains(e)" />
                        <label class="form-check-label small" for="eq-@e">@e</label>
                    </div>
                }
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-funnel me-1"></i>篩選</button>
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Rooms/Index">清除</a>
            <span class="ms-auto text-muted small align-self-center">共 @Model.Rooms.Count 間</span>
        </div>
    </div>
</form>

@if (Model.SlotFilterActive)
{
    <div class="alert alert-info py-2 small"><i class="bi bi-info-circle me-1"></i>僅顯示 @Model.Date?.ToString("yyyy/MM/dd") @Model.From?.ToString("HH:mm")–@Model.To?.ToString("HH:mm") 可預約的會議室。</div>
}

@if (Model.Rooms.Count == 0)
{
    <div class="text-center text-muted py-5"><i class="bi bi-search display-6"></i><p class="mt-2">沒有符合條件的會議室，試著放寬篩選條件。</p></div>
}
else if (Model.View == "list")
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>會議室</th><th>樓層</th><th>容納</th><th>設備</th><th>狀態</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in Model.Rooms)
                {
                    <tr>
                        <td><a asp-page="/Rooms/Details" asp-route-id="@r.Id" class="fw-semibold text-decoration-none">@r.Name</a>@(r.RequiresApproval ? " ·需審核" : "")</td>
                        <td>@r.Floor 樓</td>
                        <td>@r.Capacity 人</td>
                        <td>@string.Join("、", r.Equipment)</td>
                        <td><partial name="_RoomStatusBadge" model="r.Status" /></td>
                        <td class="text-end">
                            @if (r.Status == RoomStatus.Active)
                            {
                                <a class="btn btn-sm btn-primary" href="@(Model.BookUrl(r) ?? Url.Page("/Bookings/Create", new { roomId = r.Id }))">預約</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in Model.Rooms)
        {
            <div class="col-12 col-md-6 col-xl-4"><partial name="_RoomCard" model="(r, Model.BookUrl(r))" /></div>
        }
    </div>
}
