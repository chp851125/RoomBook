@model (Room Room, string? BookUrl)
@{ var room = Model.Room; }
<div class="card h-100 border-0 shadow-sm room-card @(room.Status != RoomStatus.Active ? "opacity-75" : "")">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h3 class="h6 mb-1"><a class="text-decoration-none" asp-page="/Rooms/Details" asp-route-id="@room.Id">@room.Name</a></h3>
            <partial name="_RoomStatusBadge" model="room.Status" />
        </div>
        <div class="text-muted small mb-2">
            <i class="bi bi-layers me-1"></i>@room.Floor 樓
            <i class="bi bi-people ms-2 me-1"></i>@room.Capacity 人
            @if (room.RequiresApproval) { <span class="badge text-bg-light border ms-2">需審核</span> }
        </div>
        <p class="small text-muted mb-2 room-desc">@room.Description</p>
        <div class="mb-3">
            @foreach (var e in room.Equipment) { <span class="badge rounded-pill text-bg-light border me-1">@e</span> }
        </div>
        <div class="mt-auto d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary flex-fill" asp-page="/Rooms/Details" asp-route-id="@room.Id">詳情</a>
            @if (room.Status == RoomStatus.Active)
            {
                <a class="btn btn-sm btn-primary flex-fill" href="@(Model.BookUrl ?? Url.Page("/Bookings/Create", new { roomId = room.Id }))">預約</a>
            }
        </div>
    </div>
</div>
