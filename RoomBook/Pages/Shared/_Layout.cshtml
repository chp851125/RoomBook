@using Microsoft.Extensions.Configuration
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@{
    var nav = ViewData["Nav"] as string ?? "";
    var isAdmin = User.IsInRole("Admin");
    var allowReset = isAdmin && Config.GetValue<bool>("Features:AllowDataReset");
}
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d6efd" />
    <title>@ViewData["Title"] - RoomBook 會議室預約</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="has-bottom-nav">
    <header class="app-topbar sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container-xl">
                <a class="navbar-brand fw-semibold" asp-page="/Index"><i class="bi bi-door-open-fill me-2"></i>RoomBook</a>

                <ul class="navbar-nav me-auto d-none d-lg-flex flex-row gap-1 ms-3">
                    <li class="nav-item"><a class="nav-link @(nav == "calendar" ? "active" : "")" asp-page="/Bookings/Index"><i class="bi bi-calendar3 me-1"></i>行事曆</a></li>
                    <li class="nav-item"><a class="nav-link @(nav == "rooms" ? "active" : "")" asp-page="/Rooms/Index"><i class="bi bi-building me-1"></i>會議室</a></li>
                    <li class="nav-item"><a class="nav-link @(nav == "my" ? "active" : "")" asp-page="/MyBookings/Index"><i class="bi bi-journal-check me-1"></i>我的預約</a></li>
                    @if (isAdmin)
                    {
                        <li class="nav-item"><a class="nav-link @(nav == "admin" ? "active" : "")" asp-page="/Admin/Index"><i class="bi bi-gear me-1"></i>管理</a></li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2 ms-auto">
                    @if (Env.IsDevelopment())
                    {
                        <vc:dev-toolbar allow-reset="allowReset" />
                    }
                    <a class="btn btn-light btn-sm d-none d-lg-inline-flex align-items-center" asp-page="/Bookings/Create"><i class="bi bi-plus-lg me-1"></i>新增預約</a>
                    <div class="d-none d-lg-block"><vc:notification-bell /></div>
                    <div class="dropdown d-none d-lg-block">
                        <button class="btn btn-sm btn-outline-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-page="/Account/Me"><i class="bi bi-person me-2"></i>我的帳號</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-page="/Account/Logout">
                                    <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>登出</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container-xl py-3 app-main">
        <partial name="_StatusMessage" />
        @RenderBody()
    </main>

    <partial name="_BottomNav" model="nav" />

    @if (allowReset)
    {
        <partial name="_ResetDataModal" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
