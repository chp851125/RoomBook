@model (int Page, int TotalPages, int Total, Func<int, string?> UrlOf)
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="分頁">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Model.UrlOf(Model.Page - 1)">上一頁</a></li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages（共 @Model.Total 筆）</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Model.UrlOf(Model.Page + 1)">下一頁</a></li>
        </ul>
    </nav>
}
