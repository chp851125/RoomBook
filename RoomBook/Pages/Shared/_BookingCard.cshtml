@using RoomBook.Application.Dtos
@model (MyBookingItem Item, string ReturnUrl)
@inject ITimeProvider Time
@{
    var i = Model.Item;
    var local = Time.ToLocal(i.StartUtc);
}
<div class="card border-0 shadow-sm booking-card @(i.InProgress ? "border-start border-4 border-success" : "")">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
            <div>
                <div class="booking-time fw-semibold">@local.ToString("MM/dd") @(new[]{"日","一","二","三","四","五","六"}[(int)local.DayOfWeek]) · @Time.Format(i.StartUtc, "HH:mm")–@Time.Format(i.EndUtc, "HH:mm")</div>
            </div>
            <div class="text-end">
                @if (i.InProgress) { <span class="badge text-bg-success">進行中</span> }
                else { <partial name="_BookingStatusBadge" model="i.Status" /> }
                @if (i.CheckedIn) { <span class="badge text-bg-light border">已簽到</span> }
            </div>
        </div>
        <h3 class="h6 mb-1">
            <a class="text-decoration-none" asp-page="/Bookings/Details"
               asp-route-id="@i.BookingId" asp-route-seriesId="@(i.BookingId is null ? i.SeriesId : null)"
               asp-route-date="@(i.BookingId is null ? i.OccurrenceDate?.ToString("yyyy-MM-dd") : null)">@i.Title</a>
            @if (i.IsSeries) { <i class="bi bi-arrow-repeat text-muted ms-1" title="週期預約"></i> }
        </h3>
        <div class="small text-muted mb-2"><i class="bi bi-door-open me-1"></i>@i.RoomName · <i class="bi bi-person me-1"></i>@i.OrganizerName@(i.BookingId is not null ? " · " + i.BookingNo : "")</div>
        <partial name="_BookingActions" model="(i, Model.ReturnUrl)" />
    </div>
</div>
