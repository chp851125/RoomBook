@model (string Title, int Stage, string Description)
<div class="card border-0 shadow-sm text-center py-5 px-3">
    <div class="card-body">
        <div class="display-5 text-primary mb-3"><i class="bi bi-hammer"></i></div>
        <h1 class="h4">@Model.Title</h1>
        <p class="text-muted mb-1">@Model.Description</p>
        <span class="badge text-bg-secondary">預計於階段 @Model.Stage 完成</span>
    </div>
</div>
