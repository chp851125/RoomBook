@page
@model RoomBook.Pages.MyBookings.IndexModel
@using RoomBook.Application.Dtos
@{
    ViewData["Title"] = "我的預約";
    ViewData["Nav"] = "my";
    var returnUrl = Request.Path + Request.QueryString;
    var tabs = new (MyTab Tab, string Label)[]
    {
        (MyTab.Upcoming, "即將開始"), (MyTab.Now, "進行中"), (MyTab.History, "歷史"), (MyTab.Cancelled, "已取消"), (MyTab.Invited, "我受邀的")
    };
}

<div class="d-flex align-items-center gap-2 mb-2">
    <h1 class="h4 mb-0 me-auto">我的預約</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-page-handler="IcsAll"><i class="bi bi-calendar-plus me-1"></i>匯出全部 .ics</a>
    <a class="btn btn-primary btn-sm d-none d-md-inline-flex" asp-page="/Bookings/Create"><i class="bi bi-plus-lg me-1"></i>新增預約</a>
</div>

<ul class="nav nav-pills flex-nowrap overflow-auto pb-1 mb-3 tab-scroll">
    @foreach (var (tab, label) in tabs)
    {
        <li class="nav-item">
            <a class="nav-link text-nowrap @(Model.Tab == tab ? "active" : "")" asp-route-tab="@tab">
                @label @if (Model.Counts.GetValueOrDefault(tab) > 0) { <span class="badge @(Model.Tab == tab ? "text-bg-light" : "text-bg-secondary") ms-1">@Model.Counts[tab]</span> }
            </a>
        </li>
    }
</ul>

<form method="get" class="card border-0 shadow-sm mb-3">
    <input type="hidden" name="tab" value="@Model.Tab" />
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <input type="search" name="q" value="@Model.Q" class="form-control form-control-sm" placeholder="搜尋主題、會議室、預約人、單號" aria-label="搜尋" />
            </div>
            <div class="col-12 col-md-3">
                <select name="roomId" class="form-select form-select-sm" aria-label="會議室">
                    <option value="">全部會議室</option>
                    @foreach (var r in Model.Rooms) { <option value="@r.Id" selected="@(Model.RoomId == r.Id)">@r.Name</option> }
                </select>
            </div>
            <div class="col-6 col-md-2"><input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="起日" /></div>
            <div class="col-6 col-md-2"><input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="迄日" /></div>
            <div class="col-12 col-md-1 d-flex gap-1">
                <button class="btn btn-primary btn-sm flex-fill" type="submit"><i class="bi bi-search"></i></button>
                <a class="btn btn-outline-secondary btn-sm" asp-route-tab="@Model.Tab" title="清除"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </div>
</form>

@if (Model.Result.Items.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-calendar2-x display-5"></i>
        <p class="mt-2 mb-3">這裡還沒有符合的預約。</p>
        @if (Model.Tab == MyTab.Upcoming) { <a class="btn btn-primary" asp-page="/Bookings/Create">新增預約</a> }
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model.Result.Items)
        {
            <div class="col-12 col-lg-6"><partial name="_BookingCard" model="(item, (string)returnUrl)" /></div>
        }
    </div>

    @if (Model.Result.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="分頁">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(Model.Result.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-tab="@Model.Tab" asp-route-q="@Model.Q" asp-route-roomId="@Model.RoomId" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-pageNo="@(Model.Result.Page - 1)">上一頁</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@Model.Result.Page / @Model.Result.TotalPages（共 @Model.Result.Total 筆）</span></li>
                <li class="page-item @(Model.Result.Page >= Model.Result.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-tab="@Model.Tab" asp-route-q="@Model.Q" asp-route-roomId="@Model.RoomId" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-pageNo="@(Model.Result.Page + 1)">下一頁</a>
                </li>
            </ul>
        </nav>
    }
}

<partial name="_CancelModal" />
