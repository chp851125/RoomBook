@page
@model RoomBook.Pages.Account.MeModel
@inject ITimeProvider Time
@{
    ViewData["Title"] = "我的帳號";
    ViewData["Nav"] = "me";
}

@if (Model.Me is { } me)
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar">@me.DisplayName[0]</div>
                        <div>
                            <h1 class="h5 mb-0">@me.DisplayName</h1>
                            <div class="text-muted small">@me.JobTitle · @Model.DepartmentName</div>
                        </div>
                        @if (me.Role == UserRole.Admin)
                        {
                            <span class="badge text-bg-primary ms-auto">管理員</span>
                        }
                    </div>
                    <dl class="row mb-0 small">
                        <dt class="col-4 text-muted">帳號</dt><dd class="col-8">@me.Account</dd>
                        <dt class="col-4 text-muted">Email</dt><dd class="col-8">@me.Email</dd>
                        <dt class="col-4 text-muted">違規點數</dt><dd class="col-8">@me.ViolationPoints 點</dd>
                    </dl>
                    @if (Model.IsSuspended)
                    {
                        <div class="alert alert-danger mt-3 mb-0 py-2 small">
                            <i class="bi bi-slash-circle me-1"></i>預約權限暫停至
                            @Time.ToLocal(me.SuspendedUntilUtc!.Value).ToString("yyyy/MM/dd HH:mm")
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="list-group shadow-sm">
                <a class="list-group-item list-group-item-action" asp-page="/Account/Settings"><i class="bi bi-sliders me-2"></i>個人設定（密碼、常用會議室）</a>
                <a class="list-group-item list-group-item-action" asp-page="/MyBookings/Index"><i class="bi bi-journal-check me-2"></i>我的預約</a>
                <a class="list-group-item list-group-item-action" asp-page="/Notifications/Index"><i class="bi bi-bell me-2"></i>通知中心</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="list-group-item list-group-item-action" asp-page="/Admin/Index"><i class="bi bi-gear me-2"></i>管理後台</a>
                }
            </div>
            <form method="post" asp-page="/Account/Logout" class="mt-3">
                <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-box-arrow-right me-1"></i>登出</button>
            </form>
        </div>
    </div>
}
